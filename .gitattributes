# Forza le terminazioni di riga Unix (LF) sui file che vanno eseguiti su Linux.
# Senza questa regola, Git su Windows potrebbe convertirli in CRLF
# e gli script fallirebbero con errori come "/bin/bash^M: bad interpreter".
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.conf     text eol=lf
*.md       text eol=lf
